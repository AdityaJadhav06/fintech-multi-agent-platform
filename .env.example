# FinTech Multi-Agent Platform Configuration

# Application
APP_NAME=FinTech Multi-Agent Platform
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
# Default: Local SQLite (Zero setup for student labs)
# Production: mysql+aiomysql://user:password@localhost:3306/fintech_platform or postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./fintech_platform.db

# LLM & Embedding Engine Mode: "ollama", "mock", or "gemini"
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Local Ollama Settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud Settings (optional, when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Auth0 Authentication & Multi-Tenancy
# Set MOCK_AUTH_ENABLED=True for offline student labs without active Auth0 tenant
MOCK_AUTH_ENABLED=True
AUTH0_DOMAIN=dev-example.us.auth0.com
AUTH0_AUDIENCE=https://api.fintech-multi-agent.local
AUTH0_ISSUER=https://dev-example.us.auth0.com/
AUTH0_ALGORITHMS=RS256

# Document Storage
UPLOAD_DIR=./uploads
